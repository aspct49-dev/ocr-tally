# ---------------------------------------------------------------
# AI invoice extraction
#
# Set exactly ONE provider key. The server derives the provider, the
# endpoint, and a sensible default model from whichever key it finds,
# so nothing else below is required.
# ---------------------------------------------------------------

# Google Gemini - recommended for this POC. Free tier, strong on
# documents. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter - free vision models (":free" suffix). Rate limited.
# OPENROUTER_API_KEY=

# Groq - free tier, very fast.
# GROQ_API_KEY=

# OpenAI - paid. Kept for backwards compatibility.
# OPENAI_API_KEY=

# Fully local and private via Ollama. No key needed; run:
#   ollama pull qwen2.5vl:7b
# AI_PROVIDER=ollama

# ---------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------

# Force a provider regardless of which key is present:
#   openai | gemini | openrouter | groq | ollama
# AI_PROVIDER=

# Override the model. Defaults per provider:
#   gemini      -> gemini-3.6-flash
#   openrouter  -> qwen/qwen2.5-vl-72b-instruct:free
#   groq        -> meta-llama/llama-4-scout-17b-16e-instruct
#   ollama      -> qwen2.5vl:7b
#   openai      -> gpt-5
# AI_INVOICE_MODEL=

# Any OpenAI-compatible chat/completions endpoint (LM Studio, vLLM, ...)
# AI_API_URL=

# AI_TIMEOUT_MS=45000

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=4173
DATA_DIR=
